                <mxCell id="notes" value="KEY DESIGN NOTES" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#333333" parent="1" vertex="1">
                    <mxGeometry x="60" y="670" width="240" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="• Solid arrows travel left → right (call). Dashed arrows are responses.&#10;• Provider is created per request. Sync QwenLocalProvider runs via asyncio.to_thread + wait_for.&#10;• tokens_used is counted on every 200 response. Cloud stays base; no LoRA adapter is applied here.&#10;• Correlation ID is copied from X-Request-ID; this service does not mint a new UUID." style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="700" width="1200" height="90" as="geometry"/>
                </mxCell>
            </root>
