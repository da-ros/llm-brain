                    <mxGeometry x="480" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="4. get_provider&#10;tier=free or premium" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="700" y="110" width="160" height="90" as="geometry"/>
