                <mxCell id="f2" value="FLOW 2 — ETL TRIPLE EXTRACTION (same base model)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#82b366" parent="1" vertex="1">
