<mxfile host="65bd71144e">
    <diagram id="api-router-dataflow" name="API Router — Data Flow">
        <mxGraphModel dx="1806" dy="884" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="API Router — Data Flow (Frame 1.1)&#10;Upload is async (Kafka). Chat is sync (HTTP). Clients poll GET /tasks/:correlation_id." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="520" y="16" width="1100" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="col_u" value="UPLOAD (async Kafka)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#b85450" parent="1" vertex="1">
                    <mxGeometry x="80" y="90" width="240" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="u1" value="1. POST /api/upload&#10;(file)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="130" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="u2" value="2. Validate JWT&#10;Premium only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="230" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u3" value="3. Correlation ID&#10;X-Request-ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="320" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u4" value="4. Save file&#10;MongoDB GridFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="410" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u5" value="5. task_status&#10;in_progress + TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="500" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u6" value="6. Publish Kafka&#10;file.uploaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="590" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="u7" value="7. Return 202&#10;{correlation_id}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="680" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="u8" value="8–10. ETL consumes,&#10;processes, publishes&#10;task.response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="780" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="u9" value="11–12. Router consumes&#10;updates task_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="890" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="col_q" value="CHAT (sync HTTP)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#82b366" parent="1" vertex="1">
                    <mxGeometry x="360" y="90" width="220" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="q1" value="1. POST /api/chat&#10;{message, use_rag}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="130" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="q2" value="2. Validate JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="230" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="q3" value="3. RAG Service HTTP&#10;Premium + use_rag only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="320" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="q4" value="4. LLM Service HTTP&#10;POST /generate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="420" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="q5" value="5. Return 200&#10;{response, correlation_id}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="520" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="col_p" value="POLLING" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#9673a6" parent="1" vertex="1">
                    <mxGeometry x="640" y="90" width="120" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="1. GET /tasks/:id&#10;JWT required" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="130" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="2. Query MongoDB&#10;task_status by _id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="230" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p3" value="3a. Same user → 200&#10;in_progress / success / error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="330" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p4" value="3b. Missing → 404&#10;Other user → 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="430" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="col_k" value="TASK.RESPONSE (retry / DLQ)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=5;fontColor=#b85450" parent="1" vertex="1">
                    <mxGeometry x="920" y="90" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="k1" value="1. Consume&#10;task.response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="130" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="k2" value="2. Classify&#10;success / 5xx / 3xx-4xx" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="240" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="k3" value="3a. success&#10;status = success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="530" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="k4" value="3b. 5xx and retries &lt; max&#10;re-publish file.uploaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
