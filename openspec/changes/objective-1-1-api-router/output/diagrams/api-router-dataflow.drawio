  <diagram id="api-router-dataflow" name="Frame 1.1 — API Router Data Flow">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Frame 1.1 — API Router Data Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="900" y="20" width="500" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== UPLOAD PATH (Async) ===== -->
        <mxCell id="upload_label" value="UPLOAD PATH (Async via Kafka)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=5;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="1. POST /api/upload&#xa;(file)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="u2" value="2. Validate JWT&#xa;Extract user_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u3" value="3. Generate&#xa;correlation_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u4" value="4. Save file to&#xa;MongoDB GridFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u5" value="5. Save task_status&#xa;{status: in_progress}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u6" value="6. Publish to Kafka&#xa;file.uploaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="760" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="u7" value="7. Return 202&#xa;{correlation_id}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="880" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== QUERY PATH (Sync) ===== -->
        <mxCell id="query_label" value="QUERY PATH (Sync via HTTP)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=5;fontColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="320" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="q1" value="1. POST /api/chat&#xa;{message, use_rag}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="q2" value="2. Validate JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="q3" value="3. Call RAG Service&#xa;(HTTP sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="q4" value="4. Call LLM Service&#xa;(HTTP sync)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="510" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="q5" value="5. Return 200&#xa;{response}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="180" height="90" as="geometry"/>
        </mxCell>

        <!-- ===== POLLING PATH ===== -->
        <mxCell id="poll_label" value="POLLING PATH" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=5;fontColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="720" y="100" width="150" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="1. GET /tasks/:id&#xa;(every 2 seconds)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="140" width="180" height="80" as="geometry"/>
