# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# ondevice = React Native / Neural Engine / Metal (Qwen3.5-4B Q4)
# qwen_local (alias: local) = LLM Service on this Mac, Qwen3.5-4B bfloat16, port 8003
LLM_PROVIDER=qwen_local
LLM_MODEL=Qwen3.5-4B
LLM_SERVICE_URL=http://localhost:8003

# --- LLM Service (port 8003) — local process, not in Compose ---
# Containers call host.docker.internal:8003. See .env.example-mac and
# .env.example-linux for per-machine presets; copy one to .env.
# LLM_BACKEND: qwen_local = in-process Qwen3.5-4B (Mac/Metal);
#              ollama     = local Ollama server (Linux).
# QWEN_MOCK=true wins over any backend: CI and tests never reach a real model.
LLM_BACKEND=qwen_local
QWEN_MODEL_ID=qwen3.5-4b
QWEN_HF_MODEL_ID=Qwen/Qwen3.5-4B
QWEN_DEVICE=auto
QWEN_MOCK=true
# Ollama (only used when LLM_BACKEND=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# thinking (reasoning): false = respuestas rápidas (default); true = razona
# antes de responder (lento, ~10x tokens)
OLLAMA_THINK=false
INFERENCE_TIMEOUT_SECONDS=600

# --- Fine-Tune Service (port 8004) — local LoRA; adapter is Premium on-device only ---
BASE_MODEL_ID=qwen3.5-4b
LORA_BACKEND=peft
LORA_MOCK=true
TRAINING_EPOCHS=5
TRAINING_LR=0.001
MAX_TRAINING_TIME_HOURS=2
FINETUNE_SERVICE_URL=http://localhost:8004

# --- Embeddings (Frame 3 RAG) ---
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_DIM=2048
EMBEDDING_MOCK=true

# --- Data stores (local Docker) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=llm_brain
CHROMA_HOST=localhost
CHROMA_PORT=8005
VECTOR_STORE_PROVIDER=chroma

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
RAG_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003
ETL_SERVICE_URL=http://localhost:8001

# --- Kafka (API Router / ETL) ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILE_UPLOADED=file.uploaded
KAFKA_TOPIC_TASK_RESPONSE=task.response
KAFKA_TOPIC_DLQ=task.dlq
MAX_RETRIES=3
TASK_STATUS_TTL_DAYS=30

# --- Auth (JWT + bcrypt) ---
JWT_SECRET_KEY=local-dev-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Encryption (Fernet — rag-service only, at-rest chunk text + vector copy) ---
# Default = urlsafe_b64(sha256("FERNET_KEY@TESIS_MESTRIA_UPS")).
# Production: override with a stable key from the secret store. Changing the key
# makes previously stored ciphertext unreadable (no recovery).
FERNET_KEY=JEWS9jt7GqTkkv1N8y-Kld5V8IeFZMw_UFFhn4h-xsU=

# --- Subscription ---
SUBSCRIPTION_TIER=free
