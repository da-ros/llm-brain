# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# ondevice = React Native / Neural Engine / Metal (Qwen3.5-4B Q4)
# qwen_local (alias: local) = LLM Service container, Qwen3.5-4B base, port 8003
LLM_PROVIDER=qwen_local
LLM_MODEL=Qwen3.5-4B
LLM_SERVICE_URL=http://localhost:8003

# --- Embeddings (later frames) ---
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B

# --- Data stores (local Docker) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=llm_brain
CHROMA_PERSIST_DIR=./data/chroma

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
RAG_SERVICE_URL=http://localhost:8002
LLM_SERVICE_URL=http://localhost:8003
ETL_SERVICE_URL=http://localhost:8001

# --- Kafka (API Router / ETL) ---
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILE_UPLOADED=file.uploaded
KAFKA_TOPIC_TASK_RESPONSE=task.response
KAFKA_TOPIC_DLQ=task.dlq
MAX_RETRIES=3
TASK_STATUS_TTL_DAYS=30

# --- Auth (JWT + bcrypt) ---
JWT_SECRET_KEY=local-dev-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Encryption (Fernet, later frames) ---
FERNET_KEY=change-me-in-production

# --- Subscription ---
SUBSCRIPTION_TIER=free
