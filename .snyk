  # langchain-community - No fix available in latest version (0.4.2)
  SNYK-PYTHON-LANGCHAINCOMMUNITY-19233333:
    - langchain-community@0.4.2:
        reason: >-
          No fix available. langchain-community maintainers have not patched
          this SSRF vulnerability. Affects document loaders when processing
          untrusted URLs.
        expires: '2027-03-28T00:00:00.000Z'

  # unstructured - Open Redirect
  SNYK-PYTHON-UNSTRUCTURED-19233386:
    - unstructured@0.18.32:
        reason: >-
          Fix requires unstructured>=0.24.0 which needs Python <3.14.
          Project uses Python 3.14. Will resolve when Python 3.14 is
          supported by unstructured or when project downgrades to Python 3.13.
        expires: '2027-03-28T00:00:00.000Z'

  # nltk - Directory Traversal (transitive via unstructured; no direct
  # requirement of any service, no upstream fix available)
  SNYK-PYTHON-NLTK-20936872:
    - '*':
        reason: >-
          No fix available. Reached only through etl > unstructured@0.18.32
          > nltk@3.10.3 (transitive); not a direct requirement of any
          service. ETL text extraction runs on trusted local files, not
          attacker-controlled archives.
        expires: '2027-01-01T00:00:00.000Z'

